void reset_magnetic_field(){

	for (Int_t iPM=0; iPM<N_PM; iPM++) {
		vB[iPM].SetXYZ(0,0,0);
	}
}

// Function to calculate the overall average Earth magnetic field for all height levels and grid points
TVector3 getAverageEarthField() {
	Float_t sum_Bx = 0.0, sum_By = 0.0, sum_Bz = 0.0;
	int count = 0;

	// Loop through all height levels (52cm, 90cm, 130cm) and all grid points
	for (int iz = 0; iz < 3; iz++) {
		for (int ix = 0; ix < 4; ix++) {
			for (int iy = 0; iy < 4; iy++) {
				// Accumulate the values of the magnetic field components
				sum_Bx += earth_Bx[iz][ix][iy];
				sum_By += earth_By[iz][ix][iy];
				sum_Bz += earth_Bz[iz][ix][iy];
				count++;  // Increment the count for averaging
			}
		}
	}

	// Compute the average for each component
	Float_t avg_Bx = sum_Bx / count;
	Float_t avg_By = sum_By / count;
	Float_t avg_Bz = sum_Bz / count;
	//std::cout <<Form("Average | Bx: %.2f, By: %.2f, Bz: %.2f",avg_Bx, avg_By, avg_Bz) <<std::endl;

	// Return the average values as a vector (Bx, By, Bz)
	return TVector3(avg_Bx, avg_By, avg_Bz);
}



// Calculate B-field of all PMTs for one coil segment
void calc_segment(TVector3 v_seg, TVector3 v_curr, Float_t d_seg, TVector3 point, TVector3& aB) {
	// Position of grid point from coil segment
	TVector3 v_point_rel = point - v_seg;

	// Calculate vector product
	TVector3 v_prod = v_curr.Cross(v_point_rel);

	// Distance from coil segment to grid point
	Float_t r_this = v_point_rel.Mag();

	// Biot-Savart
	Float_t factor = 1 / (4*TMath::Pi()) / pow(r_this, 3) * am2mg * d_seg;
	TVector3 vB_seg = v_prod * factor;

	// Add to magnetic field vector for this grid point
	aB += vB_seg;
}


// Calculate B-field of all PMTs for linear coil part
void calc_linear(Float_t curr, TVector3 v_start, TVector3 v_end, TVector3 point, TVector3& aB) {
	// Number of segments
	Float_t l_coil = (v_end - v_start).Mag();
	Int_t n_seg = (int)(l_coil / l_seg);
	Float_t d_seg = l_coil / n_seg;

	// Initialize poly-line
	TPolyLine3D* pl = new TPolyLine3D(n_seg+1);
	pl->SetNextPoint(v_start.X(), v_start.Y(), v_start.Z());

	// Loop for segments
	for (Int_t iSeg=0; iSeg<n_seg; iSeg++) {

		// Position of this segment
#ifdef FLAG_OLD
		Float_t factor = 1. / n_seg * (iSeg + 0.0);
#else
		Float_t factor = 1. / n_seg * (iSeg + 0.5);
#endif      
		TVector3 v_seg = v_start + (v_end - v_start) * factor;

		// Current vector
		TVector3 v_curr = v_end - v_start;
		v_curr = v_curr.Unit() * curr;

		// Calculate B-field for this segment
		calc_segment(v_seg, v_curr, d_seg, point, aB);

		// Add poly-line
		TVector3 v1 = v_seg + v_curr.Unit() * (d_seg / 2.);
		pl->SetNextPoint(v1.X(), v1.Y(), v1.Z());

	}

	// Add poly-line to TObjArray for poly-line 
	poly_coil->Add(pl);

}

void calc_coilHK(TVector3 point, TVector3& aB) {
	for (Int_t iCoil = 0; iCoil < N_COIL_HK; iCoil++) {
		if (iCoil <= 1) {  // X-axis coil
			// Start/end position of each segment
			TVector3 v_start_top (x_HK_start[iCoil], y_HK_start[iCoil], z_HK_start[iCoil]);
			TVector3 v_end_top   (x_HK_start[iCoil], y_HK_start[iCoil] + 3600, z_HK_start[iCoil]);

			TVector3 v_start_side1 = v_end_top;
			TVector3 v_end_side1   = v_start_side1;
			v_end_side1[2] -= 2200;

			TVector3 v_start_bot = v_end_side1;
			TVector3 v_end_bot   = v_start_bot;
			v_end_bot[1] -= 3600;

			TVector3 v_start_side2 = v_end_bot;
			TVector3 v_end_side2   = v_start_top;

			// Calculate B-field for 4 segments, using the current grid point
			calc_linear(curr_HK[iCoil], v_start_top, v_end_top, point, aB);
			calc_linear(curr_HK[iCoil], v_start_side1, v_end_side1, point, aB);
			calc_linear(curr_HK[iCoil], v_start_bot, v_end_bot, point, aB);
			calc_linear(curr_HK[iCoil], v_start_side2, v_end_side2, point, aB);
		}
		else if (iCoil <= 3) {  // Y-axis coil
			TVector3 v_start_top (x_HK_start[iCoil], y_HK_start[iCoil], z_HK_start[iCoil]);
			TVector3 v_end_top   (x_HK_start[iCoil] + 3600, y_HK_start[iCoil], z_HK_start[iCoil]);

			TVector3 v_start_side1 = v_end_top;
			TVector3 v_end_side1   = v_start_side1;
			v_end_side1[2] -= 2200;

			TVector3 v_start_bot = v_end_side1;
			TVector3 v_end_bot   = v_start_bot;
			v_end_bot[0] -= 3600;

			TVector3 v_start_side2 = v_end_bot;
			TVector3 v_end_side2   = v_start_top;

			// Calculate B-field for 4 segments, using the current grid point
			calc_linear(curr_HK[iCoil], v_start_top, v_end_top, point, aB);
			calc_linear(curr_HK[iCoil], v_start_side1, v_end_side1, point, aB);
			calc_linear(curr_HK[iCoil], v_start_bot, v_end_bot, point, aB);
			calc_linear(curr_HK[iCoil], v_start_side2, v_end_side2, point, aB);
		}
		else {  // Z-axis coil
			TVector3 v_start1 (x_HK_start[iCoil], y_HK_start[iCoil], z_HK_start[iCoil]);
			TVector3 v_end1   (x_HK_start[iCoil] + 3600, y_HK_start[iCoil], z_HK_start[iCoil]);

			TVector3 v_start2 = v_end1;
			TVector3 v_end2   = v_start2;
			v_end2[1] += 3600;

			TVector3 v_start3 = v_end2;
			TVector3 v_end3   = v_start3;
			v_end3[0] -= 3600;

			TVector3 v_start4 = v_end3;
			TVector3 v_end4   = v_start1;

			// Calculate B-field for 4 segments
			calc_linear(curr_HK[iCoil], v_start1, v_end1, point, aB);
			calc_linear(curr_HK[iCoil], v_start2, v_end2, point, aB);
			calc_linear(curr_HK[iCoil], v_start3, v_end3, point, aB);
			calc_linear(curr_HK[iCoil], v_start4, v_end4, point, aB);
		}
	}
}

// Main function
int main(int argc, char *argv[]) {

	gStyle->SetPalette(1, 0);
	gStyle->SetOptStat(0); // 통계 정보 숨김
	gStyle->SetNumberContours(20); // 컨투어 수 설정
	// Read PMT position file
	std::ifstream ifs_pmt_pos("pmtpos.dat");
	Int_t cab_this;
	Float_t x_this, y_this, z_this;
	for (Int_t iPM=0; iPM<N_PM_HK; iPM++) {
		ifs_pmt_pos >> cab_this >> x_this >> y_this >> z_this;
		v_pmt_HK[cab_this-1].SetXYZ(x_this, y_this, z_this);
	}

	if (argc != 8)
	{
		std::cout << "No enough arguments(Need to 6 current values, and output file name)" << std::endl; 
		return -1;
	}

	// Get HK precalibration current
	for (int i = 1; i < argc-1; i++)
	{
		curr_HK[i-1] = std::stof(argv[i]);
	}
	TString outrootfile = argv[argc-1];  

	// Initialize B-field vectors
	for (Int_t iPM=0; iPM<N_PM; iPM++) {
		vB[iPM].SetXYZ(0,0,0);
	}

	// Initialize TObjArray for poly-line 
	poly_coil = new TObjArray();

	// Draw poly-lines
	TCanvas* c1 = new TCanvas("c1", "c1", 0, 0, 1200, 600);

	// Calculate B-field from HK precalibration coils

	c1->cd(1);
	// Draw HK precalibration coils
	Int_t nPoly = poly_coil->GetEntries();
	for (Int_t iPoly=0; iPoly<nPoly; iPoly++) {
		TPolyLine3D* poly_this = (TPolyLine3D*)poly_coil->At(iPoly);
		if (iPoly<2) { poly_this->SetLineColor(kBlack);
		} else if (iPoly >2 && iPoly <4) { poly_this->SetLineColor(kMagenta);
		} else if (iPoly >4 && iPoly <6) { poly_this->SetLineColor(kBlue);
		}
		poly_this->SetLineWidth(2);
		poly_this->Draw("same");
	}

	// Define tree to output results
	//	TFile* ofile = new TFile("test.root", "RECREATE");
	TFile* ofile = new TFile(outrootfile+".root", "RECREATE");
	TTree* tree = new TTree("tree", "");

	Float_t i1 = curr_HK[0];
	Float_t i2 = curr_HK[1];
	Float_t i3 = curr_HK[2];

	Int_t aPM;
	TVector3 aPos, aB;
	Float_t aBx, aBy, aBz;
	Float_t aBpara, aBperp, aBmag;

	tree->Branch("pm", &aPM);
	tree->Branch("pos", &aPos);
	tree->Branch("B", &aB);
	tree->Branch("Bx", &aBx);
	tree->Branch("By", &aBy);
	tree->Branch("Bz", &aBz);
	tree->Branch("Bmag", &aBmag);
	tree->Branch("Bperp", &aBperp);
	tree->Branch("Bpara", &aBpara);

	//////////////////////////////////////////////////////////////////////////////////////////////

	const int gridX = 8;  // Number of grid points in the X direction with 1m spacing
	const int gridY = 8;  // Number of grid points in the Y direction with 1m spacing
	const int gridZ = 5;  // Number of grid points in the Z direction with 50cm spacing

	// Define coil region with Z-axis height limited to 2.2m (-1100mm to 1100mm)
	Float_t x_min = -1800;
	Float_t x_max = 1800;
	Float_t y_min = -1800;
	Float_t y_max = 1800;
	Float_t z_min = -1100;
	Float_t z_max = 1100;

	// Create a grid of points with 1m steps for X and Y, and 50cm steps for Z
	Float_t dx = 500.0;  // 50cm step for X
	Float_t dy = 500.0;  // 50cm step for Y
	Float_t dz = 500.0;   // 50cm step for Z

	std::cout << "Grid step size: dx = " << dx << ", dy = " << dy << ", dz = " << dz << std::endl;

	int total_points = gridX * gridY * gridZ;
	int progress_counter = 0;

	TH2D* h2d = new TH2D("h2d", "Magnetic Field at Z=1000mm;X (mm);Y (mm);Bmag (mG)",
			gridX, x_min, x_max,
			gridY, y_min, y_max);

	// 특정 Z 값 설정 (1m = 1000mm)
	Float_t targetZ = -100; // Z = 1000mm

/*
	TH3D* h3d = new TH3D("h3d", "Magnetic Field in Coil;X (mm);Y (mm);Z (mm)",
			gridX, x_min, x_max,
			gridY, y_min, y_max,
			gridZ, z_min, z_max
			);
*/

	// Loop over the 3D grid
	for (int ix = 0; ix < gridX; ix++) {
		for (int iy = 0; iy < gridY; iy++) {
			for (int iz = 0; iz < gridZ; iz++) {
				// Get the coordinates of the grid point
				Float_t x = x_min + ix * dx;
				Float_t y = y_min + iy * dy;
				Float_t z = z_min + iz * dz;

				if (z == targetZ) {
					// Calculate the magnetic field at this grid point
					TVector3 point(x, y, z);
					TVector3 aB(0, 0, 0);  // Reset magnetic field vector

					calc_coilHK(point, aB);

					TVector3 earthMF = getAverageEarthField();
					aB += earthMF;

					// Calculate the magnitude of the magnetic field
					Float_t aBmag = aB.Mag();
					std::cout << "(" << x << ", " << y << ", " << z << "), "
						<< "Bx = " << aB.X() << " mG, "
						<< "By = " << aB.Y() << " mG, "
						<< "Bz = " << aB.Z() << " mG, "
						<< "Bmag = " << aBmag << " mG" << std::endl;

					//			h3d->Fill(x, y, z, aBmag);
					h2d->Fill(x, y, aBmag);
					// Update progress periodically
					if (++progress_counter % 10 == 0) {
						std::cout << "Progress: " << progress_counter << "/" << total_points << " points calculated." << std::endl;
					}
					tree->Fill();
				}	
			}
		}
	}

	TCanvas* c2 = new TCanvas("Bmag", "Bmag", 1200, 900);
	TPad *pad = new TPad("Pad", "Pad", 0.1, 0.1, 0.95, 0.95);
	pad->SetRightMargin(0.05); // 오른쪽 여백 설정
	pad->SetLeftMargin(0.05); // 왼쪽 여백 설정
	pad->Draw();
	pad->cd();
	h2d->Draw("COLZ"); // 히스토그램 그리기 (COLZ 옵션)

	// 히스토그램의 각 bin 값을 텍스트로 표시
	h2d->SetMinimum(1e-9); // 0인 부분을 피하기 위해 최소값 설정
	h2d->SetMarkerSize(1.5); // 텍스트 크기 설정 (값을 조정하여 크기를 변경)
	h2d->Draw("TEXT same"); // TEXT 옵션으로 텍스트 표시

	TMarker* mar[N_PM_HK];

	for (Int_t iPM = 0; iPM < N_PM_HK; iPM++) {
		Float_t xPM = v_pmt_HK[iPM].X(); // 10.; // [mm] -> [cm] 변환
		Float_t yPM = v_pmt_HK[iPM].Y(); // 10.;
		mar[iPM] = new TMarker(xPM, yPM, kOpenCircle); // 마커 생성
		mar[iPM]->SetMarkerSize(7); // 마커 크기 설정
		mar[iPM]->SetMarkerColor(kRed);
		mar[iPM]->Draw("same"); // 히스토그램 위에 마커 그리기
	}

	c2->Update();
	ofile->cd();
	tree->Write();
	c1->Write();
	c2->Write();
	ofile->Close();

}


