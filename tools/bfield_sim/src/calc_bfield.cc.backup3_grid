	h_By->Fill(x_MF_measured[ix], y_MF_measured[iy], z_MF_measured[iz], earth_By[iz][ix][iy]);
	h_Bz->Fill(x_MF_measured[ix], y_MF_measured[iy], z_MF_measured[iz], earth_Bz[iz][ix][iy]);
	} TVector3 aPos, aB;
	}
	}
	*/
	/////////////////////////////////////////////// No use ////////////////////////////////////////////////////////////


	/////////////////////////////////////// Remove this line //////////////////////////////////////////////////////////
	/*
	   TVector3 earthMF = getAverageEarthField();

	// Loop over PMTs
	for (Int_t iPM=0; iPM<N_PM_HK; iPM++) {

	// Calculated magnetic field for PMT
	aB.SetXYZ(vB_HK[iPM].X(), vB_HK[iPM].Y(), vB_HK[iPM].Z());
	// aB += b_earth_x;

	//		TVector3 earthMF (h_Bx->Interpolate(v_pmt_HK[iPM].X(), v_pmt_HK[iPM].Y(), v_pmt_HK[iPM].Z()), 
	//				h_By->Interpolate(v_pmt_HK[iPM].X(), v_pmt_HK[iPM].Y(), v_pmt_HK[iPM].Z()), 
	//				h_Bz->Interpolate(v_pmt_HK[iPM].X(), v_pmt_HK[iPM].Y(), v_pmt_HK[iPM].Z())
	//

