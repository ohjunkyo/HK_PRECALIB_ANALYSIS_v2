	/////////////////////////////////////// Remove this line //////////////////////////////////////////////////////////

	// Write tree
	ofile->cd();
	tree->Write();
	c1->Write();
	ofile->Close();

}

void find_100mG_region(Float_t current[3]) {
	reset_magnetic_field();

	const int gridX = 7;  // Number of grid points in the X direction with 1m spacing
	const int gridY = 7;  // Number of grid points in the Y direction with 1m spacing
	const int gridZ = 5;  // Number of grid points in the Z direction with 50cm spacing

	// Define coil region with Z-axis height limited to 2.2m (-1100mm to 1100mm)
	Float_t x_min = -1800;
	Float_t x_max = 1800;
	Float_t y_min = -1800;
	Float_t y_max = 1800;
	Float_t z_min = -1100;
	Float_t z_max = 1100;

	// Create a grid of points with 1m steps for X and Y, and 50cm steps for Z
	Float_t dx = 500.0;  // 1m step for X
	Float_t dy = 500.0;  // 1m step for Y
	Float_t dz = 500.0;   // 50cm step for Z

	std::cout << "Grid step size: dx = " << dx << ", dy = " << dy << ", dz = " << dz << std::endl;

	int total_points = gridX * gridY * gridZ;
	int progress_counter = 0;

	// Loop over the 3D grid
	for (int ix = 0; ix < gridX; ix++) {
		for (int iy = 0; iy < gridY; iy++) {
			for (int iz = 0; iz < gridZ; iz++) {
				// Get the coordinates of the grid point
				Float_t x = x_min + ix * dx;
				Float_t y = y_min + iy * dy;
				Float_t z = z_min + iz * dz;

				// Calculate the magnetic field at this grid point
				TVector3 point(x, y, z);
				TVector3 aB(0, 0, 0);  // Reset magnetic field vector

				calc_coilHK();  // Calculate the coil's contribution

				TVector3 earthMF = getAverageEarthField();
				aB += earthMF;

				// Calculate the magnitude of the magnetic field
				Float_t aBmag = aB.Mag();

				std::cout << "Region with Bmag between 90mG and 110mG found at: (" << x << ", " << y << ", " << z << "), "
					<< "Bx = " << aB.X() << " mG, "
					<< "By = " << aB.Y() << " mG, "
					<< "Bz = " << aB.Z() << " mG, "
					<< "Bmag = " << aBmag << " mG" << std::endl;
				// Update progress periodically
				if (++progress_counter % 10 == 0) {
					std::cout << "Progress: " << progress_counter << "/" << total_points << " points calculated." << std::endl;
				}
			}
		}
	}

	std::cout << "Grid calculation completed." << std::endl;
}

