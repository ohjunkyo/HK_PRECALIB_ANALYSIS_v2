#include <iostream>
#include <TCanvas.h>
#include <TH2F.h>
#include <TLatex.h>
#include <TEllipse.h>
#include <TBox.h>
#include <TMarker.h>
#include <TVector3.h>
#include <TTree.h>
#include <TStyle.h>
#include <TFile.h>
#include <TMath.h>
#include <TPaletteAxis.h>

#define N_GRID_POINTS 245  // 7x7x5 그리드 포인트 수

// Main function
int main(int argc, char *argv[]) {
	gStyle->SetPalette(1, 0);

	gErrorIgnoreLevel = kFatal; // Suppressing Information message

	// Define arrays to store grid positions and B-field vectors
	TVector3 v_pos[N_GRID_POINTS];  // 그리드 포인트의 위치 배열
	TVector3 v_mag[N_GRID_POINTS];  // 그리드 포인트에서의 자기장 벡터 배열

	// Read B-field tree from the file
	TString fname;
	TString outname;
	if (argc == 3) {
		fname = argv[1];   // 입력받은 파일명
		outname = argv[2]; // 출력할 PDF 파일명
	} else {
		std::cout << "Usage: ./draw $B-field_root_file $output_draw_file(pdf)" << std::endl;
		return -1;
	}

	TFile* ifile = TFile::Open(fname);
	TTree* tree = (TTree*)ifile->Get("tree");
	Int_t grid_index;
	TVector3* gridPos = new TVector3();
	TVector3* gridB = new TVector3();
	tree->SetBranchAddress("grid_index", &grid_index);
	tree->SetBranchAddress("grid_pos", &gridPos);
	tree->SetBranchAddress("grid_B", &gridB);

	// Fill arrays with grid data
	for (Int_t i = 0; i < N_GRID_POINTS; i++) {
		tree->GetEntry(i);
		v_pos[grid_index] = *gridPos;
		v_mag[grid_index] = *gridB;
	}

	// Prepare to draw
	TCanvas* c1 = new TCanvas("c1", "c1", 0, 0, 1600, 1000);
	TH2F* hframe = new TH2F("hframe", "", 100, -1800, 1800, 100, -1800, 1800);
	hframe->SetStats(0);
	Int_t ncolors = gStyle->GetNumberOfColors();
	TH2F* h_dummy = new TH2F("h_dummy", "", 2, 0, 2, 1, 0, 1);
	c1->SaveAs(outname + ".pdf" + "[");

	// Make histograms
	TH1F* h_perp = new TH1F("h_perp", "", 20, 0., 0.);
	h_perp->SetCanExtend(TH1::kAllAxes);

	// Make markers for grid points
	TMarker* mar[N_GRID_POINTS];
	for (Int_t i = 0; i < N_GRID_POINTS; i++) {
		Float_t x = v_pos[i].X() / 10.; // [mm] -> [cm]
		Float_t y = v_pos[i].Y() / 10.;
		Float_t z = v_pos[i].Z() / 10.;
		mar[i] = new TMarker(x, y, kFullCircle);
		mar[i]->SetMarkerSize(1.5); // 마커 크기를 적절히 조정
	}

	// Loop for drawing patterns
	for (Int_t iDraw = 0; iDraw < 6; iDraw++) {
		// Find max and min B field
		Float_t B_max = -1e5, B_min = 1e5;
		Float_t B_draw[N_GRID_POINTS];
		for (Int_t i = 0; i < N_GRID_POINTS; i++) {
			if (iDraw == 0)      B_draw[i] = v_mag[i].X();
			else if (iDraw == 1) B_draw[i] = v_mag[i].Y();
			else if (iDraw == 2) B_draw[i] = v_mag[i].Z();
			else if (iDraw == 3) B_draw[i] = v_mag[i].Mag();
			else if (iDraw == 4) B_draw[i] = v_mag[i] * TVector3(0, 0, 1); // Z 방향 자기장 성분
			else if (iDraw == 5) B_draw[i] = sqrt(v_mag[i].Mag2() - pow(v_mag[i] * TVector3(0, 0, 1), 2)); // XY 평면 자기장 성분

			if (B_draw[i] > B_max) {
				B_max = B_draw[i];
			}
			if (B_draw[i] < B_min) {
				B_min = B_draw[i];
			}
		}

		// Make color palette
		h_dummy->SetBinContent(1, 1, B_min);
		h_dummy->SetBinContent(2, 1, B_max);
		h_dummy->Draw("COLZ");
		c1->Update();
		TPaletteAxis* palette = (TPaletteAxis*)h_dummy->GetListOfFunctions()->FindObject("palette");

		// Set title
		if (iDraw == 0)      hframe->SetTitle("X Component of Magnetic Field");
		else if (iDraw == 1) hframe->SetTitle("Y Component of Magnetic Field");
		else if (iDraw == 2) hframe->SetTitle("Z Component of Magnetic Field");
		else if (iDraw == 3) hframe->SetTitle("Magnetic Field Magnitude");
		else if (iDraw == 4) hframe->SetTitle("Z Direction Component");
		else if (iDraw == 5) hframe->SetTitle("XY Plane Component");

		// Draw frame and palette
		hframe->Draw();
		palette->Draw("same");

		// Draw markers with color based on magnetic field strength
		for (Int_t i = 0; i < N_GRID_POINTS; i++) {
			Int_t color_this = gStyle->GetColorPalette((int)((B_draw[i] - B_min) * (ncolors - 1) / (B_max - B_min)));
			mar[i]->SetMarkerColor(color_this);
			mar[i]->Draw("same");
		}

		// Fill histogram for perpendicular component
		if (iDraw == 5) {
			for (Int_t i = 0; i < N_GRID_POINTS; i++) {
				h_perp->Fill(B_draw[i]);
			}
		}

		// Save canvas
		c1->SaveAs(outname + ".pdf");
	}

	// Draw B-field histogram
	tree->Draw("grid_B.Mag()");
	c1->SaveAs(outname + ".pdf");
	h_perp->SetTitle(";B_{perp} [mG]");
	h_perp->Draw();
	c1->SaveAs(outname + ".pdf");
	c1->SaveAs(outname + ".pdf" + "]");  // 출력 파일명으로 저장

}

